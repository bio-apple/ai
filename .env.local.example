# 复制为 .env.local（已在 .gitignore，勿提交）
# npm run build 的 prebuild 会自动加载

# 可选：本地构建注入（与 GitHub Actions Variables 对齐）
# VIDEO_SYNC_API_URL=https://bioai-video-sync.<account>.workers.dev
# VIDEO_SYNC_SHARED_KEY=bioai-videos

# 可选：分析（构建时写入 dist）
# GA_MEASUREMENT_ID=
# CLARITY_PROJECT_ID=

# 可选：抓取脚本（本地手动跑 fetch_*.py 时用）
# YOUTUBE_API_KEY=
# GITHUB_TOKEN=
