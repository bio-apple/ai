---
import { type VideoItem, formatViews, formatZhDate } from '../lib/ssr-lists';

interface Props {
  youtube: VideoItem[];
  bilibili: VideoItem[];
}

const { youtube, bilibili } = Astro.props;
const HOT = 1_000_000;

function isBilibili(v: VideoItem) {
  return v.platform === 'bilibili' || String(v.id || '').startsWith('bilibili:');
}
---

{
  youtube.length || bilibili.length ? (
    <section class="video-day" data-ssr-videos>
      <header class="video-shelf-head">
        <h3 class="video-day-title">近 1 个月 · 按播放量</h3>
      </header>
      {[
        { label: 'YouTube', key: 'youtube', videos: youtube },
        { label: 'B站', key: 'bilibili', videos: bilibili },
      ].map((block) =>
        block.videos.length ? (
          <div class={`video-category video-category--${block.key}`}>
            <div class="video-category-head">
              <h4 class="video-category-title">
                <span class="video-platform-mark" aria-hidden="true" />
                {block.label}
              </h4>
              <p class="video-category-count">{block.videos.length} 条</p>
            </div>
            <div class="video-grid" data-video-grid={block.key}>
              {block.videos.map((v, i) => {
                const hot = (v.views || 0) >= HOT;
                const rank = i + 1;
                return (
                  <article class="video-card">
                    <a
                      class="video-card-link"
                      href={v.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track="video-click"
                    >
                      <span class="video-thumb">
                        <img
                          src={v.thumbnail || ''}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          width="640"
                          height="360"
                          referrerpolicy={isBilibili(v) ? 'no-referrer' : undefined}
                        />
                        <span class="video-rank" data-rank={rank}>
                          {rank}
                        </span>
                        <span class="video-play-badge" aria-hidden="true">
                          ▶
                        </span>
                        {v.duration && <span class="video-duration">{v.duration}</span>}
                      </span>
                      <span class="video-body">
                        <span class="video-title">{v.title}</span>
                        <span class="video-meta">
                          <span class="video-meta-author">{v.author || v.channel || '未知作者'}</span>
                          {v.published_at && (
                            <span class="video-meta-date">{formatZhDate(v.published_at)}</span>
                          )}
                          <span class:list={['video-meta-views', { 'video-meta-views--hot': hot }]}>
                            {formatViews(v.views || 0)}
                          </span>
                        </span>
                      </span>
                    </a>
                  </article>
                );
              })}
            </div>
          </div>
        ) : null,
      )}
    </section>
  ) : (
    <p class="loading-hint">暂无视频数据，每日北京时间 04:00 自动更新。</p>
  )
}
