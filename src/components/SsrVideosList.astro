---
import {
  type VideoItem,
  formatViews,
  formatZhDate,
  platformLabel,
} from '../lib/ssr-lists';

interface Props {
  youtube: VideoItem[];
  bilibili: VideoItem[];
}

const { youtube, bilibili } = Astro.props;
const HOT = 1_000_000;

function isBilibili(v: VideoItem) {
  return v.platform === 'bilibili' || String(v.id || '').startsWith('bilibili:');
}
---

{
  youtube.length || bilibili.length ? (
    <section class="video-day" data-ssr-videos>
      <h3 class="video-day-title">
        按播放量
        <span class="video-day-count">
          YouTube {youtube.length} · B站 {bilibili.length}
        </span>
      </h3>
      {[
        { label: 'YouTube', key: 'youtube', videos: youtube },
        { label: 'B站', key: 'bilibili', videos: bilibili },
      ].map((block) =>
        block.videos.length ? (
          <div class="video-category">
            <h4 class="video-category-title">
              {block.label} <span class="video-day-count">{block.videos.length} 条</span>
            </h4>
            <div class="video-grid" data-video-grid={block.key}>
              {block.videos.map((v) => {
                const hot = (v.views || 0) >= HOT;
                const summary =
                  hot && v.summary ? `热门推荐 · ${v.summary}` : v.summary || '';
                return (
                  <article class="video-card">
                    <a
                      class="video-thumb"
                      href={v.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track="video-click"
                    >
                      <img
                        src={v.thumbnail || ''}
                        alt={v.title}
                        loading="lazy"
                        decoding="async"
                        width="640"
                        height="360"
                        referrerpolicy={isBilibili(v) ? 'no-referrer' : undefined}
                      />
                      <span class="content-type-badge content-type-video" aria-hidden="true">
                        视频
                      </span>
                      <span class="video-play-btn" aria-hidden="true">
                        ▶ 观看
                      </span>
                      {v.duration && <span class="video-duration">{v.duration}</span>}
                      {v.max_height != null && (
                        <span class="video-quality">{v.max_height}p</span>
                      )}
                      <span class={`video-platform video-platform-${v.platform || 'youtube'}`}>
                        {platformLabel(v)}
                      </span>
                      {hot && <span class="video-hot">热门</span>}
                    </a>
                    <div class="video-body">
                      <h4>
                        <a
                          href={v.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-track="video-click"
                        >
                          {v.title}
                        </a>
                      </h4>
                      {summary && <p class="video-summary">{summary}</p>}
                      <div class="video-meta">
                        <span>{v.author || v.channel || '未知作者'}</span>
                        {v.published_at && <span>{formatZhDate(v.published_at)}</span>}
                        <span>播放 {formatViews(v.views || 0)}</span>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="video-category video-category-empty">
            <h4 class="video-category-title">{block.label}</h4>
            <p class="loading-hint">暂无该平台推荐</p>
          </div>
        ),
      )}
    </section>
  ) : (
    <p class="loading-hint">暂无视频数据，每日北京时间 0:00 自动更新。</p>
  )
}
