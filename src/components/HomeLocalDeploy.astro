---
import localDeploy from '../../data/local-deploy.json';

type LocalItem = {
  id: string;
  name: string;
  tagline?: string;
  summary: string;
  url: string;
  docs_url?: string;
  guide_anchor?: string;
  platforms?: string[];
  tags?: string[];
};

type LocalCategory = {
  id: string;
  label: string;
  blurb?: string;
  items: LocalItem[];
};

type GuideSection = {
  id: string;
  heading: string;
  body?: string[];
  code?: string;
  code_lang?: string;
};

type LocalGuide = {
  id: string;
  title: string;
  lead?: string;
  audience?: string;
  stack?: string[];
  sections: GuideSection[];
  notes?: string[];
};

const categories = (localDeploy.categories || []) as LocalCategory[];
const guide = (localDeploy as { guide?: LocalGuide }).guide;
const updatedAt = localDeploy.updated_at || '';
---

<div class="local-deploy" data-ssg="1">
  {
    updatedAt && (
      <p class="video-update-meta" id="local-update-meta">
        精选更新于 {updatedAt}
      </p>
    )
  }

  {
    categories.length === 0 ? (
      <p class="loading-hint">暂无本地部署条目。</p>
    ) : (
      categories.map((cat) => (
        <section class="local-cat" aria-labelledby={`local-cat-${cat.id}`}>
          <h3 class="local-cat-title" id={`local-cat-${cat.id}`}>
            {cat.label}
          </h3>
          {cat.blurb && <p class="local-cat-blurb">{cat.blurb}</p>}
          <div class="local-grid">
            {cat.items.map((item) => (
              <article class="local-card">
                <div class="local-card-head">
                  <span class="content-type-badge content-type-local" aria-hidden="true">
                    本地
                  </span>
                  {(item.tags || []).slice(0, 2).map((tag) => (
                    <span class="local-tag">{tag}</span>
                  ))}
                </div>
                <h4 class="local-card-title">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="local-click"
                  >
                    {item.name}
                  </a>
                </h4>
                {item.tagline && <p class="local-tagline">{item.tagline}</p>}
                <p class="local-summary">{item.summary}</p>
                {item.platforms?.length ? (
                  <p class="local-platforms">
                    <span class="local-platforms-label">平台</span>
                    {item.platforms.join(' · ')}
                  </p>
                ) : null}
                <div class="local-card-actions">
                  <a
                    class="local-link-btn"
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="local-visit"
                  >
                    官网 <span aria-hidden="true">↗</span>
                  </a>
                  {item.docs_url && (
                    <a
                      class="local-link-btn local-link-btn-muted"
                      href={item.docs_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track="local-docs"
                    >
                      文档
                    </a>
                  )}
                  {item.guide_anchor && (
                    <a
                      class="local-link-btn local-link-btn-muted"
                      href={`#${item.guide_anchor}`}
                      data-track="local-guide"
                    >
                      部署文稿
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    )
  }

  {
    guide && (
      <article
        class="local-guide"
        id={`local-guide-${guide.id}`}
        aria-labelledby={`local-guide-title-${guide.id}`}
      >
        <header class="local-guide-header">
          <p class="local-guide-kicker">实战文稿</p>
          <h3 class="local-guide-title" id={`local-guide-title-${guide.id}`}>
            {guide.title}
          </h3>
          {guide.lead && <p class="local-guide-lead">{guide.lead}</p>}
          <div class="local-guide-meta">
            {guide.audience && <span>{guide.audience}</span>}
            {guide.stack?.length ? <span>{guide.stack.join(' · ')}</span> : null}
          </div>
        </header>

        {guide.sections.map((section) => (
          <section
            class="local-guide-section"
            id={`local-guide-sec-${section.id}`}
            aria-labelledby={`local-guide-h-${section.id}`}
          >
            <h4 class="local-guide-heading" id={`local-guide-h-${section.id}`}>
              {section.heading}
            </h4>
            {(section.body || []).map((p) => (
              <p class="local-guide-body">{p}</p>
            ))}
            {section.code && (
              <pre class="local-guide-code">
                <code class={`language-${section.code_lang || 'text'}`}>{section.code}</code>
              </pre>
            )}
          </section>
        ))}

        {guide.notes?.length ? (
          <aside class="local-guide-notes" aria-label="注意事项">
            <h4 class="local-guide-heading">注意事项</h4>
            <ul>
              {guide.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
          </aside>
        ) : null}
      </article>
    )
  }
</div>
