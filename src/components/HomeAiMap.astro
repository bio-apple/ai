---
/**
 * 首页「AI 领域地图」— 内联 SVG 关系图
 * - 全部闭合 ellipse/circle；交叉靠半透明叠色
 * - 圈层与下方文字按钮指向同一课程 / 工具 / 开源列表
 */
import { asset } from '../lib/paths';

const roadmapHref = asset('ai-learning-roadmap.html');
const toolsHref = asset('tools/hub.html');
const courses = (hash: string) => `${asset('courses.html')}#${hash}`;
const ossAgentHref = `${asset('oss.html')}#agent`;

type MapNode = {
  id: string;
  group: 'core' | 'app';
  label: string;
  dest: string;
  hint: string;
  href: string;
};

const nodes: MapNode[] = [
  {
    id: 'ai',
    group: 'core',
    label: '人工智能',
    dest: '工具中心',
    hint: '打开工具中心，对比 ChatGPT、Claude、Cursor 等',
    href: toolsHref,
  },
  {
    id: 'ml',
    group: 'core',
    label: '机器学习',
    dest: '机器学习课程',
    hint: '打开机器学习课程列表',
    href: courses('ml'),
  },
  {
    id: 'dl',
    group: 'core',
    label: '深度学习',
    dest: '深度学习课程',
    hint: '打开深度学习课程列表',
    href: courses('dl'),
  },
  {
    id: 'cv',
    group: 'app',
    label: '计算机视觉',
    dest: '深度学习课程',
    hint: '打开深度学习课程（含 CS231n）',
    href: courses('dl'),
  },
  {
    id: 'robotics',
    group: 'app',
    label: '机器人',
    dest: 'Agent 开源',
    hint: '打开 Agent 开源精选',
    href: ossAgentHref,
  },
  {
    id: 'nlp',
    group: 'app',
    label: '自然语言处理',
    dest: 'LLM / NLP 课程',
    hint: '打开 LLM / NLP 课程列表',
    href: courses('llm'),
  },
  {
    id: 'speech',
    group: 'app',
    label: '语音识别',
    dest: '深度学习课程',
    hint: '打开深度学习课程列表',
    href: courses('dl'),
  },
];

const groups: { id: MapNode['group']; label: string }[] = [
  { id: 'core', label: '核心圈层' },
  { id: 'app', label: '应用交叉' },
];
---

<section
  class="home-section fade-in home-ai-map"
  id="home-ai-map"
  aria-labelledby="home-ai-map-title"
>
  <div class="section-head">
    <p class="section-kicker">知识版图</p>
    <h2 class="section-title" id="home-ai-map-title">AI 领域如何层层嵌套</h2>
    <p class="section-desc">
      人工智能包含机器学习，再深入到深度学习；视觉、语音、机器人、NLP
      等应用交叉其中。悬停圈层可看去向；手机请点下方按钮。
    </p>
  </div>

  <figure class="ai-map-figure">
    <div class="ai-map">
      <svg
        class="ai-map-svg"
        viewBox="240 120 720 540"
        xmlns="http://www.w3.org/2000/svg"
        role="group"
        aria-labelledby="home-ai-map-title"
        aria-describedby="ai-map-hint"
      >
        <a
          class="ai-map-node"
          href={toolsHref}
          data-track="home-ai-map-node"
          data-map-node="ai"
        >
          <title>人工智能：查看工具中心</title>
          <ellipse class="ai-map-ring-ai" cx="600" cy="390" rx="330" ry="255"></ellipse>
          <text class="ai-map-label-main" x="600" y="168" text-anchor="middle">人工智能</text>
          <text class="ai-map-label-sub" x="600" y="190" text-anchor="middle"
            >Artificial Intelligence</text
          >
        </a>

        <a
          class="ai-map-node"
          href={courses('ml')}
          data-track="home-ai-map-node"
          data-map-node="ml"
        >
          <title>机器学习：查看课程</title>
          <ellipse class="ai-map-ring-ml" cx="620" cy="405" rx="220" ry="175"></ellipse>
          <text class="ai-map-label-main ai-map-label-md" x="620" y="268" text-anchor="middle"
            >机器学习</text
          >
          <text class="ai-map-label-sub" x="620" y="288" text-anchor="middle">Machine Learning</text>
        </a>

        <a
          class="ai-map-node"
          href={courses('dl')}
          data-track="home-ai-map-node"
          data-map-node="dl"
        >
          <title>深度学习：查看课程</title>
          <circle class="ai-map-ring-dl" cx="640" cy="395" r="72"></circle>
          <text class="ai-map-label-main ai-map-label-sm" x="640" y="392" text-anchor="middle"
            >深度学习</text
          >
          <text class="ai-map-label-sub" x="640" y="412" text-anchor="middle">Deep Learning</text>
        </a>

        <a
          class="ai-map-node"
          href={courses('dl')}
          data-track="home-ai-map-node"
          data-map-node="cv"
        >
          <title>计算机视觉：查看深度学习课程（含 CS231n）</title>
          <ellipse class="ai-map-ring-app" cx="470" cy="360" rx="175" ry="58"></ellipse>
          <text class="ai-map-label-app" x="400" y="356" text-anchor="middle">计算机视觉</text>
          <text class="ai-map-label-sub" x="400" y="374" text-anchor="middle">Computer Vision</text>
        </a>

        <a
          class="ai-map-node"
          href={ossAgentHref}
          data-track="home-ai-map-node"
          data-map-node="robotics"
        >
          <title>机器人：查看 Agent 开源精选</title>
          <ellipse class="ai-map-ring-app" cx="390" cy="305" rx="88" ry="62"></ellipse>
          <text class="ai-map-label-app" x="390" y="302" text-anchor="middle">机器人</text>
          <text class="ai-map-label-sub" x="390" y="320" text-anchor="middle">Robotics</text>
        </a>

        <a
          class="ai-map-node"
          href={courses('llm')}
          data-track="home-ai-map-node"
          data-map-node="nlp"
        >
          <title>自然语言处理：查看 LLM / NLP 课程</title>
          <ellipse class="ai-map-ring-app" cx="610" cy="520" rx="168" ry="58"></ellipse>
          <text class="ai-map-label-app" x="610" y="516" text-anchor="middle">自然语言处理</text>
          <text class="ai-map-label-sub" x="610" y="534" text-anchor="middle"
            >Natural Language Processing</text
          >
        </a>

        <a
          class="ai-map-node"
          href={courses('dl')}
          data-track="home-ai-map-node"
          data-map-node="speech"
        >
          <title>语音识别：查看深度学习课程</title>
          <ellipse class="ai-map-ring-app" cx="730" cy="455" rx="98" ry="48"></ellipse>
          <text class="ai-map-label-app" x="730" y="452" text-anchor="middle">语音识别</text>
          <text class="ai-map-label-sub" x="730" y="470" text-anchor="middle">Speech Recognition</text>
        </a>
      </svg>
    </div>

    <p class="ai-map-hint" id="ai-map-hint" aria-live="polite">
      <span class="ai-map-hint-idle">悬停圈层可看去向。手机请点下方按钮。</span>
      {
        nodes.map((node) => (
          <span class="ai-map-hint-item" data-map-hint={node.id}>
            <strong>{node.label}</strong>
            <span class="ai-map-hint-arrow" aria-hidden="true">
              →
            </span>
            {node.hint}
          </span>
        ))
      }
    </p>

    <nav class="ai-map-legend" aria-label="按领域打开对应列表">
      {
        groups.map((group) => (
          <div class="ai-map-legend-group" data-map-group={group.id}>
            <p class="ai-map-legend-label">{group.label}</p>
            <ul class="ai-map-legend-list">
              {nodes
                .filter((node) => node.group === group.id)
                .map((node) => (
                  <li>
                    <a
                      class="ai-map-btn"
                      href={node.href}
                      data-track="home-ai-map-btn"
                      data-map-node={node.id}
                    >
                      <span class="ai-map-btn-name">{node.label}</span>
                      <span class="ai-map-btn-dest">{node.dest}</span>
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <figcaption class="ai-map-caption">
      交叉靠叠色表达包含关系。圈层和按钮通向同一列表。
      <a href={roadmapHref} class="ai-map-link" data-track="home-ai-map-roadmap">查看学习路线 →</a>
    </figcaption>
  </figure>
</section>
