---
import { pickHomeOss } from '../lib/runtime';

const items = pickHomeOss(3);
const domainColors: Record<string, string> = {
  'agent-framework': '#2563eb',
  'inference-framework': '#10b981',
  'vector-db': '#f59e0b',
  'local-deployment': '#8b5cf6',
};
---
<div id="home-oss-preview" class="home-oss-preview" data-ssg="1">
  {items.length === 0 ? (
    <p class="loading-hint">暂无开源项目数据。</p>
  ) : (
    <div class="oss-grid">
      {items.map(({ project, domainLabel, domainId }, idx) => {
        const color = domainColors[domainId] || '';
        const style = color ? `--domain-color:${color}` : '';
        const rank = idx + 1;
        return (
          <article class="oss-card" style={style}>
            <div class="oss-card-head">
              <span class="oss-domain-badge">{domainLabel}</span>
              <span class="oss-stars">★ {(project.stars || 0).toLocaleString('zh-CN')}</span>
            </div>
            <h4>
              <span class="oss-rank">#{rank}</span>
              <a href={project.url} target="_blank" rel="noopener" data-track="oss-click">{project.name}</a>
              {rank <= 3 && <span class="oss-top-badge">TOP{rank}</span>}
            </h4>
            <p class="oss-repo">{project.repo}</p>
            <p class="oss-summary">{project.description || ''}</p>
            <a href={project.url} target="_blank" rel="noopener" class="oss-read" data-track="oss-read">在 GitHub 打开 →</a>
          </article>
        );
      })}
    </div>
  )}
</div>
