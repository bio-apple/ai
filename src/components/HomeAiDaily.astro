---
import {
  pickAiDailyBrief,
  pickHomeVideos,
  formatNewsDate,
  displayNewsTitle,
} from '../lib/runtime';
import { formatRelativeTime, newsSourceMeta } from '../lib/content-display';
import { asset } from '../lib/paths';
import dailyVideos from '../../daily-videos.json';
import NewsSourceChip from './NewsSourceChip.astro';

const brief = pickAiDailyBrief();
const homeVideos = pickHomeVideos(1, dailyVideos);
const newsItem = brief.models[0] || brief.industry[0];
const ossItem = brief.github[0];
const videoItem = homeVideos[0] || brief.learn[0];

function newsMeta(item: { source?: string; category?: string; published_at?: string; url?: string }) {
  const source = newsSourceMeta(item.source || item.category, item.url);
  return {
    source,
    relative: formatRelativeTime(item.published_at),
    datetime: item.published_at || '',
  };
}
---

<section class="home-section fade-in" id="home-daily">
  <div class="section-head section-head-row">
    <div>
      <h2 class="section-title">AI 简报</h2>
      <p class="section-desc">三条速览 · 详情进新闻、开源与视频专区</p>
    </div>
    {
      brief.updatedAt && (
        <p class="daily-updated">资讯更新于 {formatNewsDate(brief.updatedAt)}</p>
      )
    }
  </div>

  <div class="daily-brief">
    <ul class="daily-brief-list">
      <li class="daily-brief-item" data-brief="news">
        <span class="daily-brief-kicker">资讯</span>
        {
          newsItem ? (
            <a
              href={newsItem.url}
              target="_blank"
              rel="noopener noreferrer"
              data-track="daily_panel_click"
              data-track-panel="models"
            >
              <span class="daily-item-title">{displayNewsTitle(newsItem)}</span>
              <span class="daily-item-meta">
                <NewsSourceChip meta={newsMeta(newsItem).source} />
                {newsMeta(newsItem).relative && (
                  <time class="daily-item-date" datetime={newsMeta(newsItem).datetime}>
                    {newsMeta(newsItem).relative}
                  </time>
                )}
              </span>
            </a>
          ) : (
            <p class="daily-empty">暂无模型发布</p>
          )
        }
      </li>
      <li class="daily-brief-item" data-brief="oss" id="daily-github-list">
        <span class="daily-brief-kicker">升温</span>
        {
          ossItem ? (
            <a
              href={ossItem.url}
              target="_blank"
              rel="noopener noreferrer"
              data-track="daily_panel_click"
              data-track-panel="github"
            >
              <span class="daily-item-title">{displayNewsTitle(ossItem)}</span>
              <span class="daily-item-meta">
                <NewsSourceChip meta={newsMeta(ossItem).source} />
              </span>
            </a>
          ) : (
            <p class="daily-empty">
              暂无开源升温 ·{' '}
              <a href={asset('oss.html')} data-track="daily_empty_oss">
                看开源精选
              </a>
            </p>
          )
        }
      </li>
      <li class="daily-brief-item daily-brief-item--video" data-brief="video">
        <span class="daily-brief-kicker">视频</span>
        <div id="home-video-picks" class="home-video-preview" aria-label="编辑精选视频">
          {
            videoItem ? (
              <a
                class="home-video-teaser"
                href={videoItem.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="home-video-click"
                title={videoItem.title}
              >
                <span class="home-video-teaser-thumb">
                  {videoItem.thumbnail ? (
                    <img
                      src={videoItem.thumbnail}
                      alt={videoItem.title}
                      width="320"
                      height="180"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="home-video-teaser-empty">无封面</span>
                  )}
                  <span class="home-video-teaser-play" aria-hidden="true">
                    ▶
                  </span>
                </span>
                <span class="home-video-teaser-body">
                  <span class="home-video-teaser-title">{videoItem.title}</span>
                  <span class="home-video-teaser-meta">
                    {/bilibili/i.test(videoItem.platform || videoItem.id || '') ? 'B站' : 'YouTube'}
                    {videoItem.author || videoItem.channel
                      ? ` · ${videoItem.author || videoItem.channel}`
                      : ''}
                  </span>
                </span>
              </a>
            ) : (
              <p class="daily-empty">暂无精选视频。</p>
            )
          }
        </div>
      </li>
    </ul>
    <p class="daily-brief-more">
      <a href={asset('news/daily-ai-news.html')} data-track="daily_news_more">全部新闻</a>
      ·
      <a href={asset('oss.html')} data-track="daily_empty_oss">开源升温</a>
      ·
      <a href={asset('videos.html')} class="daily-more-videos" data-track="daily_videos_more"
        >视频片单</a
      >
    </p>
  </div>
</section>
