---
import {
  pickAiDailyBrief,
  formatNewsDate,
  displayNewsTitle,
} from '../lib/runtime';
import { asset } from '../lib/paths';

const brief = pickAiDailyBrief();
---

<section class="home-section fade-in" id="home-daily">
  <div class="section-head section-head-row">
    <div>
      <p class="section-kicker">台账</p>
      <h2 class="section-title">AI 简报</h2>
      <p class="section-desc">标题速览 · 详情进新闻与视频专区</p>
    </div>
    {
      brief.updatedAt && (
        <p class="daily-updated">资讯更新于 {formatNewsDate(brief.updatedAt)}</p>
      )
    }
  </div>

  <div class="daily-grid">
    <article class="daily-panel">
      <h3 class="daily-panel-title">模型与发布</h3>
      <ul class="daily-list">
        {
          brief.models.map((item) => (
            <li>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="daily_panel_click"
                data-track-panel="models"
              >
                <span class="daily-item-title">{displayNewsTitle(item)}</span>
                {(item.source || item.category) && (
                  <span class="daily-item-meta">
                    <span class="news-source-badge">{item.source || item.category}</span>
                  </span>
                )}
              </a>
            </li>
          ))
        }
        {brief.models.length === 0 && <li class="daily-empty">暂无模型动态</li>}
      </ul>
    </article>

    <article class="daily-panel daily-panel-github">
      <h3 class="daily-panel-title">
        GitHub 升温 <span class="daily-cadence">热</span>
      </h3>
      <script
        type="application/json"
        id="daily-github-data"
        set:html={JSON.stringify(
          (brief.githubAll?.length ? brief.githubAll : brief.github).map((item) => ({
            title: displayNewsTitle(item),
            url: item.url,
            meta: item.category || item.source || 'GitHub',
          })),
        )}
      />
      <div
        id="daily-github-list"
        class="daily-virtual-host"
        data-github-vl
        aria-label="GitHub 升温列表"
      >
        <ul class="daily-list">
          {
            brief.github.map((item) => (
              <li>
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="daily_panel_click"
                  data-track-panel="github"
                >
                  <span class="daily-item-title">{displayNewsTitle(item)}</span>
                  <span class="daily-item-meta">
                    <span class="news-source-badge">
                      {item.category || item.source || 'GitHub'}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
          {
            brief.github.length === 0 && (
              <li class="daily-empty">
                暂无 GitHub 动态 ·{' '}
                <a href={asset('oss.html')} data-track="daily_empty_oss">
                  看开源精选
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </article>

    <article class="daily-panel">
      <h3 class="daily-panel-title">行业资讯</h3>
      <ul class="daily-list">
        {
          brief.industry.map((item) => (
            <li>
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                data-track="daily_panel_click"
                data-track-panel="industry"
              >
                <span class="daily-item-title">{displayNewsTitle(item)}</span>
                {item.source && (
                  <span class="daily-item-meta">
                    <span class="news-source-badge">{item.source}</span>
                  </span>
                )}
              </a>
            </li>
          ))
        }
        {brief.industry.length === 0 && <li class="daily-empty">暂无行业资讯</li>}
      </ul>
      <a class="daily-more" href={asset('news/daily-ai-news.html')} data-track="daily_news_more"
        >全部新闻 →</a
      >
    </article>

    <article class="daily-panel daily-panel--videos">
      <h3 class="daily-panel-title">视频预览</h3>
      <p class="daily-empty">
        粘贴 YouTube / B站链接，生成带封面的推荐卡片。
      </p>
      <a class="daily-more" href={asset('videos.html')} data-track="daily_videos_more"
        >打开预览 →</a
      >
    </article>
  </div>
</section>
