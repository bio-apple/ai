---
import { type NewsItem } from '../lib/ssr-lists';
import { displayNewsTitle } from '../lib/runtime';
import { formatRelativeTime } from '../lib/content-display';
import NewsSourceChip from './NewsSourceChip.astro';

interface Props {
  items: NewsItem[];
}

const { items } = Astro.props;
---

{
  items.length ? (
    <ul class="news-feed-list" data-ssr-news>
      {items.map((item) => {
        return (
        <li class="news-row">
          <a
            class="news-row-main"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            data-track="news-click"
          >
            <span class="news-row-title">
              <span class="content-type-badge content-type-news" aria-hidden="true">
                资讯
              </span>{' '}
              {displayNewsTitle(item)}
            </span>
            <span class="news-row-meta">
              <NewsSourceChip source={item.source} />
              {item.published_at && (
                <time class="news-row-date" datetime={item.published_at}>
                  {formatRelativeTime(item.published_at)}
                </time>
              )}
            </span>
          </a>
          {item.summary && <p class="news-row-summary">{item.summary}</p>}
        </li>
        );
      })}
    </ul>
  ) : (
    <p class="loading-hint">暂无新闻数据。</p>
  )
}
