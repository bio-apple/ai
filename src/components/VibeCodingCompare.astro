---
interface VibeTool {
  name: string;
  type: string;
  models: string;
  features: string;
  cn: string;
  free: string;
  url: string;
  region: string;
  aicpb_rank: number | null;
  aicpb_visits: string | null;
  aicpb_mom: string | null;
}

interface Props {
  title: string;
  lead: string;
  headers: string[];
  tools: VibeTool[];
  updated_at: string;
  source_url: string;
  source_name: string;
}

const { title, lead, headers, tools, updated_at, source_url, source_name } = Astro.props;
---

<section class="vibe-coding-section page-section" aria-labelledby="vibe-coding-title">
  <div class="section-head">
    <h2 class="section-title" id="vibe-coding-title">{title}</h2>
    <p class="section-desc">{lead} · 更新于 {updated_at}</p>
  </div>

  <div class="hub-compare-wrap">
    <table class="hub-compare-table vibe-coding-table">
      <thead>
        <tr>
          {headers.map((h) => <th>{h}</th>)}
        </tr>
      </thead>
      <tbody>
        {tools.map((tool) => (
          <tr>
            <th>
              <span class="hub-compare-name">
                <a
                  href={tool.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hub-compare-link"
                  data-track="vibe-coding-click"
                  data-tool={tool.name}
                >
                  {tool.name}
                </a>
                <span class="hub-compare-type">{tool.region}</span>
              </span>
            </th>
            <td class="vibe-rank-cell">
              {tool.aicpb_rank != null ? (
                <span class="vibe-aicpb-rank">
                  <span class="vibe-aicpb-rank-num">#{tool.aicpb_rank}</span>
                  <span class="vibe-aicpb-visits">{tool.aicpb_visits}</span>
                  <span class:list={['vibe-aicpb-mom', tool.aicpb_mom?.startsWith('+') ? 'is-up' : 'is-down']}>
                    {tool.aicpb_mom}
                  </span>
                </span>
              ) : (
                <span class="vibe-aicpb-na">未收录</span>
              )}
            </td>
            <td>{tool.type}</td>
            <td>{tool.models}</td>
            <td class="vibe-features-cell">{tool.features}</td>
            <td>
              <span class:list={['vibe-cn-badge', tool.cn === '优秀' ? 'is-good' : 'is-ok']}>
                {tool.cn}
              </span>
            </td>
            <td class="vibe-free-cell">{tool.free}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="hub-ranking-footnote">
    排名数据来自 <a href={source_url} target="_blank" rel="noopener noreferrer">{source_name} AI Vibe Coding Rankings</a>（2026-06 月访问量）。
    国内工具暂未收录于 AICPB，已手动补充。工具信息以各官网最新公示为准。
  </p>
</section>
