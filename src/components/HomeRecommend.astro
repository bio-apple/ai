---
import { site, toolLookup, toolRelations } from '../lib/data';
import { asset } from '../lib/paths';

interface Props {
  variant?: 'default' | 'hero';
}

const { variant = 'default' } = Astro.props;
const picker = site.ai_picker;
const lookup = toolLookup();
const toolsMeta = Object.fromEntries(
  Object.entries(lookup).map(([id, t]) => [
    id,
    {
      name: (t as { name?: string }).name || id,
      tagline: (t as { tagline?: string }).tagline || '',
      href: asset(`tools/${id}.html`),
    },
  ]),
);
const recommendConfig = {
  options: picker.options,
  fallback: site.recommend_fallback,
  tools: toolsMeta,
  relations: toolRelations,
  hubHref: asset('tools/hub.html'),
};
const isHero = variant === 'hero';
---

<section
  class:list={['recommend-section', { 'recommend-section--hero': isHero, 'home-section fade-in': !isHero }]}
  id="home-recommend"
  aria-labelledby="recommend-title"
>
  {
    !isHero && (
      <div class="section-head">
        <p class="section-kicker">匹配</p>
        <h2 class="section-title" id="recommend-title">
          {picker.title}
        </h2>
        <p class="section-desc">
          {picker.lead || '点选场景或写下任务，立刻看到工具链与下一步。'}
        </p>
      </div>
    )
  }
  {isHero && <h2 class="visually-hidden" id="recommend-title">{picker.title}</h2>}

  <div class="recommend-composer">
    <form class="recommend-query" id="recommend-form" role="search">
      <label class="visually-hidden" for="recommend-input">描述你想用 AI 做什么</label>
      <input
        type="search"
        id="recommend-input"
        class="recommend-input"
        name="q"
        placeholder={picker.placeholder ||
          '例如：写产品周报 / 用 Cursor 改落地页 / 即梦出短视频分镜'}
        maxlength="200"
        autocomplete="off"
        enterkeyhint="search"
        aria-controls="recommend-result"
        aria-describedby="recommend-chip-hint"
      />
      <button type="submit" class="cta-btn" data-track="recommend-submit">开始匹配</button>
    </form>

    <div class="recommend-suggest">
      <p class="recommend-suggest-label" id="recommend-chip-hint">场景</p>
      <div
        class="recommend-chips"
        id="recommend-chips"
        role="group"
        aria-label="常见场景，点选即匹配"
      >
        {
          picker.options.map((opt) => (
            <button
              type="button"
              class="recommend-chip"
              data-recommend-chip={opt.label}
              data-picker={opt.id}
              data-track={`recommend-chip-${opt.id}`}
              aria-pressed="false"
            >
              {opt.label}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <div
    class="recommend-result"
    id="recommend-result"
    hidden
    role="region"
    aria-live="polite"
    aria-atomic="true"
    aria-label="匹配结果"
  >
  </div>

  <p class="recommend-empty-hint" id="recommend-empty-hint">
    还没有匹配。选一个场景，或写下今天的任务。
  </p>

  <script
    type="application/json"
    id="recommend-config"
    set:html={JSON.stringify(recommendConfig)}
  />
</section>
