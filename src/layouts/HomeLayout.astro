---
import ThemeBoot from '../components/ThemeBoot.astro';
import SecurityMeta from '../components/SecurityMeta.astro';
import SeoHead from '../components/SeoHead.astro';
import Favicon from '../components/Favicon.astro';
import FontLoader from '../components/FontLoader.astro';
import UxWidgets from '../components/UxWidgets.astro';
import KnowledgeAssistant from '../components/KnowledgeAssistant.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';
import { BASE, asset, assetVersioned } from '../lib/paths';
import { stringifyJsonLd } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  scripts?: string[];
  includeKnowledge?: boolean;
}

const {
  title,
  description,
  canonical = site.meta.canonical,
  schema,
  scripts = ['lib/link-guard.js', 'ux.js', 'app.js'],
  includeKnowledge = false,
} = Astro.props;

const scriptList = [...scripts];

const knowledgeSrc = includeKnowledge ? assetVersioned('knowledge.js') : '';
const knowledgeBoot = includeKnowledge
  ? `(function(){var loaded=false,src=${JSON.stringify(knowledgeSrc)};function load(){if(loaded||!src)return;loaded=true;var s=document.createElement('script');s.src=src;s.defer=true;document.body.appendChild(s);}function arm(){var fab=document.getElementById('knowledge-fab');if(!fab)return;['pointerenter','focus','touchstart'].forEach(function(ev){fab.addEventListener(ev,load,{once:true,passive:true});});}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',arm);else arm();if('requestIdleCallback' in window)requestIdleCallback(function(){load();},{timeout:4000});else setTimeout(load,2500);})();`
  : '';

const styleHref = assetVersioned('style.css');

/** 次要脚本：idle / 搜索聚焦 / 热度展开时再加载，缩短首屏关键路径 */
const DEFERRED = {
  fuse: assetVersioned('vendor/fuse.min.js'),
  funnel: assetVersioned('funnel.js'),
  analytics: assetVersioned('analytics.js'),
  recommend: assetVersioned('recommend.js'),
  engagement: assetVersioned('engagement.js'),
};
const deferredBoot = `(function(){
  var loaded={};
  function load(src,key){if(!src||loaded[key])return Promise.resolve();loaded[key]=1;return new Promise(function(res,rej){var s=document.createElement('script');s.src=src;s.defer=true;s.onload=function(){res();};s.onerror=rej;document.body.appendChild(s);});}
  var D=${JSON.stringify(DEFERRED)};
  function idleBundle(){load(D.funnel,'funnel');load(D.analytics,'analytics');load(D.recommend,'recommend');}
  function ensureFuse(){return load(D.fuse,'fuse');}
  function ensureEngagement(){return load(D.engagement,'engagement');}
  window.__BIOAI_ensureFuse=ensureFuse;
  window.__BIOAI_ensureEngagement=ensureEngagement;
  function armSearch(){document.querySelectorAll('.site-search-input').forEach(function(el){['focus','pointerdown'].forEach(function(ev){el.addEventListener(ev,function(){ensureFuse();},{once:true,passive:true});});});}
  function armOps(){var wrap=document.getElementById('home-ops-wrap');if(!wrap)return;wrap.addEventListener('toggle',function(){if(wrap.open)ensureEngagement();});}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){armSearch();armOps();});else{armSearch();armOps();}
  if('requestIdleCallback' in window)requestIdleCallback(function(){idleBundle();ensureFuse();},{timeout:3500});else setTimeout(function(){idleBundle();ensureFuse();},2000);
})();`;
---

<!doctype html>
<html lang="zh-CN" data-base={BASE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SecurityMeta />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      keywords={site.meta.keywords}
      ogType="website"
      ogImage={site.meta.og_image}
      ogImageAlt={site.meta.og_image_alt || title}
      siteName={site.meta.site_name || 'Bio AI Lab'}
    />
    <Favicon />
    <FontLoader />
    <style is:inline>
      html {
        overflow-x: hidden;
        max-width: 100%;
      }
      body {
        margin: 0;
        background: #eef3fb;
        color: #1a2234;
        font-family: system-ui, sans-serif;
      }
      #main-content {
        min-height: 40vh;
      }
      .home-ops-details {
        margin: 1.5rem 0;
        border: 1px solid var(--border, #d5ddea);
        border-radius: 14px;
        background: var(--bg-card, #fff);
        padding: 0.75rem 1rem;
      }
      .home-ops-summary {
        cursor: pointer;
        font-weight: 600;
        list-style: none;
      }
      .home-ops-summary::-webkit-details-marker {
        display: none;
      }
    </style>
    <link rel="preload" href={styleHref} as="style" />
    <link rel="stylesheet" href={styleHref} />
    <ThemeBoot assetPrefix={BASE} />
    {schema && <script type="application/ld+json" set:html={stringifyJsonLd(schema)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <UxWidgets />
    {includeKnowledge && <KnowledgeAssistant />}
    <Nav nav={site.nav} standalone={false} homeHref={asset('index.html')} navPrefix={BASE} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer text={site.footer.text} links={site.footer.links || []} />
    <script is:inline set:html={deferredBoot} />
    {knowledgeBoot && <script is:inline set:html={knowledgeBoot} />}
    {scriptList.map((src) => <script src={assetVersioned(src)} defer />)}
  </body>
</html>
