---
import StandaloneLayout from '../../layouts/StandaloneLayout.astro';
import StandalonePageHeader from '../../components/StandalonePageHeader.astro';
import SsrNewsList from '../../components/SsrNewsList.astro';
import { site } from '../../lib/data';
import { buildNewsSchema, mergeSchemaGraphs, buildPageSchema } from '../../lib/schema';
import { asset, homeHref } from '../../lib/paths';
import { prepareNewsItems } from '../../lib/ssr-lists';
import newsPayload from '../../../ai-news.json';

type QbitaiHot = {
  url?: string;
  window_days?: number;
  items?: typeof newsPayload.items;
};

const page = site.news_page;
const base = site.meta.base_url;
const breadcrumbs = [
  { name: '首页', url: `${base}` },
  { name: '新闻热点', url: `${base}news/daily-ai-news.html` },
];
const hotPayload: QbitaiHot = (newsPayload as { qbitai_hot?: QbitaiHot }).qbitai_hot || {};
const hotItems = hotPayload.items || [];
const qbitaiHotUrl = hotPayload.url || 'https://www.qbitai.com/';
const seenSchemaUrl = new Set();
const schemaItems = [];
for (const item of [...hotItems, ...(newsPayload.items || [])]) {
  const url = (item.url || '').trim();
  if (url && seenSchemaUrl.has(url)) continue;
  if (url) seenSchemaUrl.add(url);
  schemaItems.push(item);
}
const schema = mergeSchemaGraphs(
  buildPageSchema(page.title, page.lead, `${base}news/daily-ai-news.html`, breadcrumbs),
  buildNewsSchema(
    { title: page.h1 || page.title, lead: page.lead, items: schemaItems },
    base,
  ),
);
const home = homeHref();
const ssrItems = prepareNewsItems(newsPayload.items || [], 24);
const ssrHotItems = prepareNewsItems(hotItems, 12);
---

<StandaloneLayout
  title={page.title}
  description={page.lead}
  canonical={`${base}news/daily-ai-news.html`}
  schema={schema}
  ogType="website"
  scripts={[
    'lib/fetch-json.js',
    'lib/link-guard.js',
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'ux.js',
    'app.js',
    'news.js',
  ]}
>
  <div class="standalone-page">
    <StandalonePageHeader
      crumbs={[{ label: '首页', href: home }, { label: '新闻热点' }]}
      title={page.h1}
      lead={page.lead}
      metaId="news-page-meta"
    />

    <section class="page-section" aria-labelledby="qbitai-hot-title">
      <div class="section-head">
        <h2 class="section-title" id="qbitai-hot-title">量子位热门文章</h2>
        <p class="section-desc">
          近 1 个月（滚动 30 天）来自
          <a href={qbitaiHotUrl} target="_blank" rel="noopener noreferrer">量子位官网</a>
          首页热门。
        </p>
      </div>
      <div id="qbitai-hot-list" class="news-list">
        {
          ssrHotItems.length ? (
            <SsrNewsList items={ssrHotItems} />
          ) : (
            <p class="loading-hint">暂无近一个月的量子位热门文章。</p>
          )
        }
      </div>
    </section>

    <section class="page-section">
      <div id="daily-news-list" class="news-list">
        <SsrNewsList items={ssrItems} />
      </div>
      <div id="news-watch-sources" class="news-watch-sources"></div>
    </section>

    <div class="standalone-cta">
      <a href={home} class="cta-btn cta-btn-outline">返回首页</a>
      <a href={asset('videos.html')} class="cta-btn" data-track="news-to-videos">看 AI 视频 →</a>
    </div>
  </div>
</StandaloneLayout>
