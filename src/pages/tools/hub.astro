---
import StandaloneLayout from '../../layouts/StandaloneLayout.astro';
import StandalonePageHeader from '../../components/StandalonePageHeader.astro';
import RankingBoardPanels from '../../components/RankingBoardPanels.astro';
import { site } from '../../lib/data';
import { buildHubRankingBoards, hubRankingMeta, HUB_RANKING_TOP_N } from '../../lib/hub';
import { buildPageSchema } from '../../lib/schema';
import { asset, homeHref } from '../../lib/paths';

const page = site.tools_hub_page;
const base = site.meta.base_url;
const breadcrumbs = [
  { name: '首页', url: `${base}` },
  { name: '工具中心', url: `${base}tools/hub.html` },
];
const schema = buildPageSchema(page.title, page.lead, `${base}tools/hub.html`, breadcrumbs);
const boards = buildHubRankingBoards(HUB_RANKING_TOP_N).map((board) => ({
  ...board,
  subtitle: `${board.subtitle} · Top ${board.items.length}`,
}));
const rankMeta = hubRankingMeta();
---

<StandaloneLayout
  title={page.title}
  description={page.lead}
  canonical={`${base}tools/hub.html`}
  schema={schema}
  ogType="website"
  includeKnowledge={true}
  scripts={[
    'lib/virtual-list.js',
    'lib/link-guard.js',
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'ux.js',
    'app.js',
    'ranking-tabs.js',
  ]}
>
  <div class="standalone-page tools-hub-page hub-compare-page aicpb-ranking-page">
    <h1 class="visually-hidden">{page.h1}</h1>
    <StandalonePageHeader
      crumbs={[{ label: '首页', href: homeHref() }, { label: '工具中心' }]}
      meta={`更新 ${rankMeta.updated_at}`}
    />

    <section
      class="hub-ranking-section page-section"
      id="hub-ranking"
      aria-labelledby="hub-ranking-title"
    >
      <div class="section-head">
        <h2 class="section-title" id="hub-ranking-title">AI 工具排行</h2>
        <p class="section-desc">
          AICPB · LMSYS Chatbot Arena Elo · Artificial Analysis Intelligence Index · Top {
            HUB_RANKING_TOP_N
          }
        </p>
      </div>
      <ul class="ranking-method-list">
        <li><strong>AICPB</strong>：基于 AI 产品站点访问量与月环比的热度排行，偏应用流量视角。</li>
        <li>
          <strong>LMSYS Chatbot Arena Elo</strong>：来自真人盲测对战的 Elo 分数，偏对话质量视角。
        </li>
        <li>
          <strong>Artificial Analysis Intelligence Index</strong>
          ：综合公开基准评测得到的智能分数，偏模型能力视角。
        </li>
      </ul>

      <div class="hub-ranking-shell">
        <RankingBoardPanels
          boards={boards}
          panelIdPrefix="hub-panel"
          headingLevel="h3"
          footerSuffix="完整榜单 →"
        />
      </div>

      <p class="hub-ranking-footnote">
        完整 Top 10 与引用说明见
        <a href={asset('ai-tools-ranking.html')}>站内排行榜页</a>。
      </p>
    </section>

    <section class="vibe-coding-section page-section" aria-labelledby="vibe-coding-title">
      <div class="section-head">
        <h2 class="section-title" id="vibe-coding-title">主流 Vibe Coding 工具 Top 10</h2>
        <p class="section-desc">
          数据来源 <a href="https://www.aicpb.com/ai-rankings/products/vibe-coding-rankings" target="_blank" rel="noopener noreferrer">AICPB AI Vibe Coding Rankings</a>（2026-06 月访问量）
        </p>
      </div>

      <div class="hub-compare-wrap">
        <table class="hub-compare-table vibe-coding-table">
          <thead>
            <tr>
              <th>#</th>
              <th>产品</th>
              <th>月访问量</th>
              <th>月环比</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="vibe-rank-num">1</td>
              <th><a href="https://github.com/features/copilot" target="_blank" rel="noopener noreferrer" class="hub-compare-link">GitHub Copilot</a></th>
              <td>371.18M</td>
              <td class="vibe-mom is-down">-3.28%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">2</td>
              <th><a href="https://www.hostinger.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Hostinger</a></th>
              <td>50.26M</td>
              <td class="vibe-mom is-down">-5.51%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">3</td>
              <th><a href="https://lovable.dev/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Lovable.dev</a></th>
              <td>34.83M</td>
              <td class="vibe-mom is-down">-1.27%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">4</td>
              <th><a href="https://supabase.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Supabase</a></th>
              <td>29.73M</td>
              <td class="vibe-mom is-down">-2.50%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">5</td>
              <th><a href="https://vercel.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Vercel</a></th>
              <td>29.68M</td>
              <td class="vibe-mom is-down">-2.93%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">6</td>
              <th><a href="https://airtable.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Airtable</a></th>
              <td>27.69M</td>
              <td class="vibe-mom is-up">+0.16%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">7</td>
              <th><a href="https://cursor.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Cursor</a></th>
              <td>23.18M</td>
              <td class="vibe-mom is-up">+7.22%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">8</td>
              <th><a href="https://base44.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">BASE44 2.0</a></th>
              <td>17.16M</td>
              <td class="vibe-mom is-down">-8.58%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">9</td>
              <th><a href="https://replit.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Replit</a></th>
              <td>13.28M</td>
              <td class="vibe-mom is-down">-5.31%</td>
            </tr>
            <tr>
              <td class="vibe-rank-num">10</td>
              <th><a href="https://ollama.com/" target="_blank" rel="noopener noreferrer" class="hub-compare-link">Ollama</a></th>
              <td>12.07M</td>
              <td class="vibe-mom is-up">+4.77%</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="hub-ranking-footnote">
        数据引自 <a href="https://www.aicpb.com/ai-rankings/products/vibe-coding-rankings" target="_blank" rel="noopener noreferrer">AICPB AI Vibe Coding Rankings</a>，版权归 AICPB 所有。
      </p>
    </section>

    <section class="ranking-method page-section" aria-label="说明">
      <div class="section-head">
        <h2 class="section-title">说明</h2>
      </div>
      <ul class="ranking-method-list">
        <li>
          工具中心仅保留排行视图，展示 AICPB、LMSYS Chatbot Arena Elo、Artificial Analysis
          Intelligence Index 三榜 Top {HUB_RANKING_TOP_N}。
        </li>
        <li>热度与榜单分数不等于适合你：先看场景与定价，再用排行交叉验证。</li>
      </ul>
      <p class="aicpb-attribution">
        数据版权归
        <a href="https://www.aicpb.com/" target="_blank" rel="noopener noreferrer">AICPB</a>、
        <a href="https://arena.ai/leaderboard/text" target="_blank" rel="noopener noreferrer"
          >LMSYS Arena</a
        >、
        <a
          href="https://artificialanalysis.ai/leaderboards/models"
          target="_blank"
          rel="noopener noreferrer">Artificial Analysis</a
        >
        各自所有，本站仅作摘录展示。
      </p>
    </section>

    <div class="standalone-cta">
      <a href={homeHref()} class="cta-btn">返回首页</a>
      <a href={asset('ai-tools-ranking.html')} class="cta-btn cta-btn-outline">完整排行榜 →</a>
    </div>
  </div>
</StandaloneLayout>
