---
import StandaloneLayout from '../layouts/StandaloneLayout.astro';
import StandalonePageHeader from '../components/StandalonePageHeader.astro';
import { site } from '../lib/data';
import { buildPageSchema } from '../lib/schema';
import { homeHref } from '../lib/paths';

const base = site.meta.base_url;
const title = '视频链接预览';
const lead = '粘贴 YouTube / B站 视频或频道链接，在本浏览器生成本地封面卡片；可设置同步码跨设备合并。';
const syncApi =
  (typeof process !== 'undefined' && process.env.VIDEO_SYNC_API_URL?.replace(/\/$/, '')) ||
  (site as { video_preview_sync?: { api_url?: string } }).video_preview_sync?.api_url?.replace(
    /\/$/,
    '',
  ) ||
  '';
const cloudSyncEnabled = Boolean(syncApi);
const canonical = `${base}videos.html`;
const schema = buildPageSchema(title, lead, canonical, [
  { name: '首页', url: base },
  { name: 'AI 视频', url: canonical },
]);
---

<StandaloneLayout
  title={`${title} | Bio AI Lab`}
  description={lead}
  canonical={canonical}
  schema={schema}
  ogType="website"
  scripts={[
    'lib/link-guard.js',
    'lib/video-preview.js',
    'lib/video-preview-sync.js',
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'ux.js',
    'app.js',
    'videos.js',
  ]}
>
  <div class="standalone-page">
    <StandalonePageHeader
      crumbs={[{ label: '首页', href: homeHref() }, { label: 'AI 视频' }]}
      title={title}
      lead={lead}
    />
    <section class="page-section" aria-labelledby="video-preview-heading">
      <h2 class="visually-hidden" id="video-preview-heading">粘贴链接生成预览</h2>
      <form class="video-preview-form" id="video-preview-form">
        <label class="visually-hidden" for="video-url-input">视频链接</label>
        <input
          type="url"
          id="video-url-input"
          class="video-url-input"
          name="url"
          placeholder="粘贴视频链接，或频道如 https://www.youtube.com/@Deeplearningai"
          autocomplete="url"
          inputmode="url"
          enterkeyhint="go"
          required
        />
        <button type="submit" class="cta-btn" data-track="video-preview-submit">生成预览</button>
      </form>
      <p class="video-preview-hint" id="video-preview-hint">
        {
          cloudSyncEnabled ? (
            <>
              链接保存在<strong>本浏览器</strong>，并会<strong>自动同步到云端</strong>（需设置同步码）。
              换设备时输入相同同步码即可拉取。
            </>
          ) : (
            <>
              链接保存在<strong>本浏览器</strong>。展开「跨设备同步」可导出备份；配置云端 API 后将自动上传。
            </>
          )
        }
      </p>
      <script
        type="application/json"
        id="video-sync-config"
        set:html={JSON.stringify({ api_url: syncApi })}
      />
      <details class="video-sync-panel" id="video-sync-panel">
        <summary class="video-sync-summary">跨设备同步</summary>
        <div class="video-sync-body">
          <p class="video-sync-hint" data-sync-cloud-hint hidden>
            站点尚未配置云端 API。仓库管理员在 GitHub 添加 <code>CLOUDFLARE_API_TOKEN</code>{' '}
            后，推送 main 将自动部署同步服务。目前请用导出/同步文本。
          </p>
          {
            cloudSyncEnabled && (
              <p class="video-sync-hint video-sync-hint--on">
                云端同步已开启。首次添加链接会自动生成同步码，请在其他设备输入<strong>相同同步码</strong>。
              </p>
            )
          }
          <p class="video-sync-hint">
            同步码请自行保管（相当于密码），不要分享给不信任的人。
          </p>
          <div class="video-sync-row">
            <label class="video-sync-label" for="video-sync-key">同步码</label>
            <input
              type="text"
              id="video-sync-key"
              class="video-sync-key-input"
              placeholder="至少 8 位，如 my-ai-videos"
              autocomplete="off"
              spellcheck="false"
            />
            <button type="button" class="cta-btn cta-btn-outline" id="video-sync-generate"
              >生成</button
            >
            <button type="button" class="cta-btn" id="video-sync-save-key">保存并同步</button>
          </div>
          <p class="video-sync-status" id="video-sync-status" role="status" aria-live="polite"></p>
          <div class="video-sync-actions">
            <button type="button" class="video-sync-btn" id="video-sync-pull">从云端拉取</button>
            <button type="button" class="video-sync-btn" id="video-sync-export">导出备份</button>
            <label class="video-sync-btn video-sync-import-label">
              导入备份
              <input
                type="file"
                id="video-sync-import"
                accept="application/json,.json"
                hidden
              />
            </label>
          </div>
          <details class="video-sync-manual">
            <summary>手动：复制 / 粘贴同步文本</summary>
            <p class="video-sync-hint">在设备 A 点「复制当前列表」，通过微信/邮件发到设备 B 后粘贴并合并。</p>
            <textarea
              id="video-sync-blob"
              class="video-sync-blob"
              rows="4"
              placeholder="BIOAI1:…"
            ></textarea>
            <div class="video-sync-actions">
              <button type="button" class="video-sync-btn" id="video-sync-copy-blob"
                >复制当前列表</button
              >
              <button type="button" class="video-sync-btn" id="video-sync-merge-blob"
                >合并粘贴内容</button
              >
            </div>
          </details>
        </div>
      </details>
      <p class="video-preview-status" id="video-preview-status" role="status" aria-live="polite"></p>
      <div id="daily-video-list" class="daily-video-list video-preview-list" aria-live="polite">
        <p class="daily-empty">加载本机预览…</p>
      </div>
    </section>
    <div class="standalone-cta">
      <a href={homeHref()} class="cta-btn cta-btn-outline">返回首页</a>
    </div>
  </div>
</StandaloneLayout>
