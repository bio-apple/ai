---
import StandaloneLayout from '../layouts/StandaloneLayout.astro';
import StandalonePageHeader from '../components/StandalonePageHeader.astro';
import { site } from '../lib/data';
import { buildPageSchema } from '../lib/schema';
import { homeHref } from '../lib/paths';

const base = site.meta.base_url;
const title = '近期热门 AI 视频';
const lead = '粘贴 YouTube 或 B站 视频链接，立刻看到封面预览与推荐卡片。';
const canonical = `${base}videos.html`;
const schema = buildPageSchema(title, lead, canonical, [
  { name: '首页', url: base },
  { name: 'AI 视频', url: canonical },
]);
---

<StandaloneLayout
  title={`${title} | Bio AI Lab`}
  description={lead}
  canonical={canonical}
  schema={schema}
  ogType="website"
  scripts={[
    'lib/link-guard.js',
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'ux.js',
    'app.js',
    'videos.js',
  ]}
>
  <div class="standalone-page">
    <StandalonePageHeader
      crumbs={[{ label: '首页', href: homeHref() }, { label: 'AI 视频' }]}
      title={title}
      lead={lead}
    />
    <section class="page-section" aria-labelledby="video-preview-heading">
      <h2 class="visually-hidden" id="video-preview-heading">粘贴链接生成预览</h2>
      <form class="video-preview-form" id="video-preview-form" role="search">
        <label class="visually-hidden" for="video-url-input">视频链接</label>
        <input
          type="url"
          id="video-url-input"
          class="video-url-input"
          name="url"
          placeholder="粘贴 https://www.youtube.com/watch?v=… 或 https://www.bilibili.com/video/BV…"
          autocomplete="url"
          inputmode="url"
          enterkeyhint="go"
          required
        />
        <button type="submit" class="cta-btn" data-track="video-preview-submit">生成预览</button>
      </form>
      <p class="video-preview-hint" id="video-preview-hint">
        支持 YouTube、B站公开视频页。预览封面来自平台公开缩略图，不会下载视频文件。
      </p>
      <p class="video-preview-status" id="video-preview-status" role="status" aria-live="polite"></p>
      <div id="daily-video-list" class="daily-video-list video-preview-list"></div>
    </section>
    <div class="standalone-cta">
      <a href={homeHref()} class="cta-btn cta-btn-outline">返回首页</a>
    </div>
  </div>
</StandaloneLayout>
