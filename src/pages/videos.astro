---
import StandaloneLayout from '../layouts/StandaloneLayout.astro';
import StandalonePageHeader from '../components/StandalonePageHeader.astro';
import SsrVideosList from '../components/SsrVideosList.astro';
import { BRAND, site } from '../lib/data';
import { buildPageSchema, buildVideosSchema, mergeSchemaGraphs } from '../lib/schema';
import { homeHref } from '../lib/paths';
import { pickHomeVideos, type VideosPayload } from '../lib/runtime';
import { formatViews, platformLabel, prepareVideos } from '../lib/ssr-lists';
import dailyVideos from '../../daily-videos.json';

const base = site.meta.base_url;
const title = 'AI 视频';
const { youtube, bilibili } = prepareVideos(dailyVideos as VideosPayload);
const streamCount = youtube.length + bilibili.length;
const fallbackVideos = pickHomeVideos(3, dailyVideos as VideosPayload);
const syncCfg = (site as {
  video_preview_sync?: { api_url?: string; shared_key?: string };
}).video_preview_sync;
const syncApi =
  (typeof process !== 'undefined' && process.env.VIDEO_SYNC_API_URL?.replace(/\/$/, '')) ||
  syncCfg?.api_url?.replace(/\/$/, '') ||
  '';
const syncSharedKey =
  (typeof process !== 'undefined' && process.env.VIDEO_SYNC_SHARED_KEY?.trim()) ||
  syncCfg?.shared_key?.trim() ||
  '';
const cloudSyncEnabled = Boolean(syncApi);
const sharedSyncEnabled = Boolean(syncSharedKey);
const lead = `YouTube / B站近 1 个月上传、各平台播放量 Top 3，每天更新${streamCount ? ` · ${streamCount} 条` : ''}。首页精选 3 条，这里是完整列表。`;
const canonical = `${base}videos.html`;
const schema = mergeSchemaGraphs(
  buildPageSchema(title, lead, canonical, [
    { name: '首页', url: base },
    { name: 'AI 视频', url: canonical },
  ]),
  buildVideosSchema([...youtube, ...bilibili], canonical),
);
---

<StandaloneLayout
  title={`${title} | ${BRAND}`}
  description={lead}
  canonical={canonical}
  schema={schema}
  ogType="website"
  scripts={[
    'lib/link-guard.js',
    'lib/video-preview.js',
    'lib/video-preview-sync.js',
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'ux.js',
    'app.js',
    'videos.js',
  ]}
>
  <div class="standalone-page">
    <StandalonePageHeader
      crumbs={[{ label: '首页', href: homeHref() }, { label: title }]}
      title={title}
      lead={lead}
    />
    <section class="page-section" aria-labelledby="daily-video-stream-heading">
      <h2 class="visually-hidden" id="daily-video-stream-heading">近 1 个月高播放</h2>
      <div id="daily-video-stream">
        <SsrVideosList youtube={youtube} bilibili={bilibili} />
      </div>
    </section>
    <section class="page-section" aria-labelledby="video-preview-heading">
      <h2 id="video-preview-heading">我的收藏</h2>
      <form class="video-preview-form" id="video-preview-form">
        <label class="visually-hidden" for="video-url-input">视频链接</label>
        <input
          type="url"
          id="video-url-input"
          class="video-url-input"
          name="url"
          placeholder="粘贴视频链接，或频道如 https://www.youtube.com/@Deeplearningai"
          autocomplete="url"
          inputmode="url"
          enterkeyhint="go"
          required
        />
        <button type="submit" class="cta-btn" data-track="video-preview-submit">保存</button>
      </form>
      <p class="video-preview-hint" id="video-preview-hint">
        {
          cloudSyncEnabled && sharedSyncEnabled ? (
            <>
              粘贴链接点「保存」→ <strong>云端永久保存</strong>。任意设备打开{' '}
              <code>videos.html</code> 即可看到同一份列表，无需复制链接。
            </>
          ) : cloudSyncEnabled ? (
            <>
              粘贴链接点「保存」→ <strong>云端永久保存</strong>。地址栏会出现带 <code>?sync=</code>{' '}
              的恢复链接：收藏本页，或复制后在另一台设备 / 清除网站数据后打开，即可看到云端列表。
            </>
          ) : (
            <>粘贴链接点「保存」→ 本机保存。可编辑标题、删除。</>
          )
        }
      </p>
      <script
        type="application/json"
        id="video-sync-config"
        set:html={JSON.stringify({ api_url: syncApi, shared_key: syncSharedKey })}
      />
      {
        cloudSyncEnabled && !sharedSyncEnabled && (
          <p class="video-preview-recover" id="video-preview-recover" hidden>
            <label class="visually-hidden" for="video-recover-url">恢复链接</label>
            <input
              type="text"
              id="video-recover-url"
              class="video-recover-url-input"
              readonly
              spellcheck="false"
            />
            <button type="button" class="video-preview-recover-btn" id="video-copy-recover-link">
              复制恢复链接
            </button>
          </p>
        )
      }
      <p class="video-preview-status" id="video-preview-status" role="status" aria-live="polite"></p>
      <div id="daily-video-list" class="daily-video-list video-preview-list" aria-live="polite">
        {
          fallbackVideos.length ? (
            <div data-video-fallback>
              <p class="video-preview-fallback-note">
                还没有本机收藏时，先看近一个月高播放精选。粘贴链接保存后会出现在这里。
              </p>
              <div class="video-grid">
                {
                  fallbackVideos.map((v) => (
                    <article class="video-card">
                      <a
                        class="video-thumb"
                        href={v.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        data-track="video-fallback-click"
                      >
                        {
                          v.thumbnail ? (
                            <img
                              src={v.thumbnail}
                              alt={v.title}
                              loading="lazy"
                              decoding="async"
                              width="640"
                              height="360"
                              referrerpolicy={
                                /bilibili/i.test(v.platform || v.id || '') ? 'no-referrer' : undefined
                              }
                            />
                          ) : (
                            <span class="video-thumb-empty">无封面</span>
                          )
                        }
                        <span class="video-play-badge" aria-hidden="true">
                          ▶
                        </span>
                        <span class="video-platform-badge">{platformLabel(v)}</span>
                      </a>
                      <div class="video-info">
                        <a
                          class="video-title"
                          href={v.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          data-track="video-fallback-click"
                        >
                          {v.title}
                        </a>
                        <p class="video-channel">
                          {v.author || v.channel || platformLabel(v)}
                          {v.views ? ` · ${formatViews(v.views)}` : ''}
                        </p>
                      </div>
                    </article>
                  ))
                }
              </div>
            </div>
          ) : (
            <p class="daily-empty">粘贴 YouTube / B站 地址后点「保存」，收藏会出现在这里。</p>
          )
        }
      </div>
    </section>
    <div class="standalone-cta">
      <a href={homeHref()} class="cta-btn cta-btn-outline">返回首页</a>
    </div>
  </div>
</StandaloneLayout>
