---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeRecommend from '../components/HomeRecommend.astro';
import HomeAiDaily from '../components/HomeAiDaily.astro';
import HomeOps from '../components/HomeOps.astro';
import HomeAiMap from '../components/HomeAiMap.astro';
import { site } from '../lib/data';
import { buildHomeSchema, buildCoursesSchema, mergeSchemaGraphs } from '../lib/schema';
import { asset } from '../lib/paths';
import coursesPayload from '../../ai-courses.json';

const schema = mergeSchemaGraphs(
  buildHomeSchema(site),
  buildCoursesSchema(coursesPayload, `${site.meta.base_url}courses.html`),
);
const faqItems = site.faq || [];
const ledgerDate = new Date().toISOString().slice(0, 10);
const heatItem = [...(site.oss_frameworks || [])].sort(
  (a, b) => (b.heat_score || 0) - (a.heat_score || 0),
)[0];
---

<HomeLayout
  title={site.meta.title}
  description={site.meta.description}
  canonical={site.meta.canonical}
  schema={schema}
  scripts={['lib/link-guard.js', 'ux.js', 'app.js']}
  includeKnowledge={true}
>
  <section id="section-home" class="section active">
    <div class="hero">
      <div class="hero-content">
        <div class="hero-ledger-meta">
          <span class="hero-ledger-date">{ledgerDate}</span>
          {
            heatItem && (
              <span class="hero-heat">
                今日升温{' '}
                <a href={asset('oss.html')} data-track="hero-heat-oss">
                  {heatItem.repo || heatItem.name}
                </a>
              </span>
            )
          }
        </div>
        <div class="hero-brand-mark">
          <p class="hero-brand">{site.hero.eyebrow}</p>
        </div>
        <h1>{site.hero.title}</h1>
        <p class="hero-subtitle">{site.hero.subtitle}</p>
        <HomeRecommend variant="hero" />
      </div>
    </div>

    <div class="home-main">
      <HomeAiDaily />
      <HomeAiMap />

      <section
        class="home-section fade-in"
        id="home-community"
        aria-labelledby="home-community-title"
      >
        <div class="section-head">
          <h2 class="section-title" id="home-community-title">下一步</h2>
          <p class="section-desc">三榜选型，或看今日开源升温。</p>
        </div>
        <div class="community-links community-links--compact">
          <a href={asset('tools/hub.html')} class="community-card" data-track="home-community-hub">
            <span class="community-card-kicker">排行</span>
            <strong>AI 工具中心</strong>
            <span>AICPB / LMSYS / AA 三榜 Top 10。</span>
            <em class="community-card-cta">打开三榜 →</em>
          </a>
          <a href={asset('oss.html')} class="community-card" data-track="home-community-oss">
            <span class="community-card-kicker">升温</span>
            <strong>开源精选</strong>
            <span>Agent / MCP / Coding Agent 等方向，每向 Top 3。</span>
            <em class="community-card-cta">查看升温 →</em>
          </a>
        </div>
      </section>

      {
        faqItems.length > 0 && (
          <section class="home-section fade-in" id="home-faq" aria-labelledby="home-faq-title">
            <div class="section-head">
              <h2 class="section-title" id="home-faq-title">
                常见问题
              </h2>
              <p class="section-desc">快速回答选型与上手问题。</p>
            </div>
            <div class="home-faq-list">
              {faqItems.map((item) => (
                <details class="home-faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <details class="home-section fade-in home-ops-details" id="home-ops-wrap">
        <summary class="home-ops-summary">今日热度（可选查看）</summary>
        <HomeOps />
      </details>
    </div>
  </section>
</HomeLayout>
