---
import HomeLayout from '../layouts/HomeLayout.astro';
import HomeRecommend from '../components/HomeRecommend.astro';
import HomeAiDaily from '../components/HomeAiDaily.astro';
import HomeOps from '../components/HomeOps.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import HomeQuickFilters from '../components/HomeQuickFilters.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HomeAiMap from '../components/HomeAiMap.astro';
import { site } from '../lib/data';
import { buildHomeSchema, buildCoursesSchema, mergeSchemaGraphs } from '../lib/schema';
import { asset, homeHref } from '../lib/paths';
import coursesPayload from '../../ai-courses.json';

const homeCrumb = { label: '首页', href: homeHref(), tool: 'all' };

const schema = mergeSchemaGraphs(
  buildHomeSchema(site),
  buildCoursesSchema(coursesPayload, site.meta.canonical),
);
const OSS_CATEGORY_LABELS: Record<string, string> = {
  agent: 'Agent 框架',
  inference: '推理框架',
  vector: '向量库',
  eval: '评测工具',
  local: '本地部署',
};
const OSS_CATEGORY_ORDER = ['agent', 'inference', 'vector', 'eval', 'local'] as const;
const OSS_FRAMEWORKS = site.oss_frameworks || [];
const formatStars = (n = 0) => new Intl.NumberFormat('en-US').format(n);
const openSourceItems = OSS_FRAMEWORKS.map((fw) => {
  const category = 'category' in fw && fw.category ? String(fw.category) : 'agent';
  return {
    repo: fw.repo,
    name: fw.name,
    stars: Number(fw.stars || 0),
    summary: 'summary' in fw && fw.summary ? String(fw.summary) : '',
    category,
    categoryLabel: OSS_CATEGORY_LABELS[category] || '开源项目',
    url: `https://github.com/${fw.repo}`,
  };
}).sort((a, b) => b.stars - a.stars);
const ossCategoryLegend = OSS_CATEGORY_ORDER.map((id) => ({
  id,
  label: OSS_CATEGORY_LABELS[id],
  count: openSourceItems.filter((item) => item.category === id).length,
})).filter((row) => row.count > 0);
const faqItems = site.faq || [];
---

<HomeLayout
  title={site.meta.title}
  description={site.meta.description}
  canonical={site.meta.canonical}
  schema={schema}
  scripts={[
    'vendor/fuse.min.js',
    'funnel.js',
    'analytics.js',
    'lib/link-guard.js',
    'lib/virtual-list.js',
    'ux.js',
    'app.js',
    'recommend.js',
    'engagement.js',
    'lazy-sections.js',
  ]}
  includeKnowledge={true}
>
  <section id="section-home" class="section active">
    <div class="hero">
      <div class="hero-bg" aria-hidden="true">
        <div class="hero-grid"></div>
        <div class="hero-orb hero-orb-a"></div>
        <div class="hero-orb hero-orb-b"></div>
      </div>
      <div class="hero-content">
        <div class="hero-brand-mark">
          <span class="hero-logo-icon" aria-hidden="true">{site.nav.logo.icon}</span>
          <p class="hero-brand">{site.hero.eyebrow}</p>
        </div>
        <h1>{site.hero.title}</h1>
        <p class="hero-subtitle">{site.hero.subtitle}</p>
        <div class="hero-cta">
          <a
            href={site.hero.cta_primary?.href || '#home-recommend'}
            class="cta-btn"
            data-track="hero-cta-primary">{site.hero.cta_primary?.label || '获取 AI 推荐'}</a
          >
        </div>
        <p class="hero-secondary-link">
          <a
            href={asset(site.hero.cta_secondary?.href || 'tools/hub.html')}
            data-track="hero-cta-nav">{site.hero.cta_secondary?.label || '浏览工具中心'} →</a
          >
        </p>
        <GlobalSearch variant="hero" />
        <HomeQuickFilters />
      </div>
    </div>

    <div class="home-main">
      <HomeRecommend />
      <HomeAiDaily />
      <HomeAiMap />

      <section
        class="home-section fade-in"
        id="home-community"
        aria-labelledby="home-community-title"
      >
        <div class="section-head">
          <h2 class="section-title" id="home-community-title">继续探索</h2>
          <p class="section-desc">从排行、开源到学习路径，按需深入。</p>
        </div>
        <div class="community-links">
          <a href={asset('tools/hub.html')} class="community-card" data-track="home-community-hub">
            <span class="community-card-kicker">排行</span>
            <strong>AI 工具中心</strong>
            <span>AICPB / LMSYS / AA 三榜 Top 10。</span>
            <em class="community-card-cta">浏览工具 →</em>
          </a>
          <a
            href="#section-oss"
            class="community-card"
            data-goto="oss"
            data-track="home-community-oss"
          >
            <span class="community-card-kicker">开源</span>
            <strong>开源精选</strong>
            <span>Agent、推理、向量库、评测与本地部署精选仓库。</span>
            <em class="community-card-cta">查看精选 →</em>
          </a>
          <a
            href={asset('ai-learning-roadmap.html')}
            class="community-card"
            data-track="home-community-roadmap"
          >
            <span class="community-card-kicker">学习</span>
            <strong>AI 学习路线</strong>
            <span>从入门到工作流的分阶段路径。</span>
            <em class="community-card-cta">打开路线 →</em>
          </a>
        </div>
      </section>

      {
        faqItems.length > 0 && (
          <section class="home-section fade-in" id="home-faq" aria-labelledby="home-faq-title">
            <div class="section-head">
              <h2 class="section-title" id="home-faq-title">
                常见问题
              </h2>
              <p class="section-desc">快速回答选型与上手问题。</p>
            </div>
            <div class="home-faq-list">
              {faqItems.map((item) => (
                <details class="home-faq-item">
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <HomeOps />
    </div>
  </section>

  <section id="section-oss" class="section oss-section">
    <div class="section-panel">
      <Breadcrumb crumbs={[homeCrumb, { label: '开源精选' }]} />
      <div class="tool-header">
        <div class="tool-icon" style="background:rgba(37,99,235,0.12);color:var(--accent)">◎</div>
        <div>
          <h2>开源精选</h2>
          <p class="desc">Agent · 推理 · 向量库 · 评测 · 本地部署——按 Star 排序的多元开源清单。</p>
        </div>
      </div>
      {
        ossCategoryLegend.length > 0 && (
          <ul class="oss-cat-legend" aria-label="开源类别">
            {ossCategoryLegend.map((row) => (
              <li>
                <span class={`oss-chip oss-chip-${row.id}`}>{row.label}</span>
                <span class="oss-cat-count">{row.count}</span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="oss-feed">
        <ol class="oss-card-grid" aria-label="开源精选仓库">
          {
            openSourceItems.map((item, index) => (
              <li class="oss-card-item" style={`--oss-i:${index}`}>
                <a
                  class={`oss-card oss-card--${item.category}`}
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="oss-click"
                  aria-label={`${item.name}，${item.categoryLabel}，${formatStars(item.stars)} stars，在 GitHub 打开`}
                >
                  <div class="oss-card-top">
                    <span class={`oss-chip oss-chip-${item.category}`}>{item.categoryLabel}</span>
                    <span class="oss-card-stars" title="GitHub Stars">
                      <span aria-hidden="true">★</span> {formatStars(item.stars)}
                    </span>
                  </div>
                  <div class="oss-card-identity">
                    <span class="oss-card-rank">#{index + 1}</span>
                    <h3 class="oss-card-title">{item.name}</h3>
                    {index < 3 && <span class="oss-chip oss-chip-top">TOP {index + 1}</span>}
                  </div>
                  <p class="oss-card-repo">{item.repo}</p>
                  <p class="oss-card-summary">
                    {item.summary ||
                      `GitHub Star：★ ${formatStars(item.stars)}，${item.categoryLabel}相关开源仓库。`}
                  </p>
                  <span class="oss-card-cta">
                    在 GitHub 打开 <span aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
        {openSourceItems.length === 0 && <p class="loading-hint">暂无开源项目数据。</p>}
      </div>
    </div>
  </section>

  <section id="section-courses" class="section courses-section">
    <noscript><p class="loading-hint error-hint">请启用 JavaScript 以加载课程资源。</p></noscript>
    <div class="section-panel">
      <Breadcrumb crumbs={[homeCrumb, { label: '课程资源' }]} />
      <div class="tool-header">
        <div class="tool-icon" style="background:rgba(37,99,235,0.12);color:var(--accent)">📚</div>
        <div>
          <h2>AI 课程资源</h2>
          <p class="desc" id="courses-lead">
            按学习路线精选免费课：微软与谷歌入门，斯坦福 CS230 / CS231n / CS224n / CS336（YouTube
            最新学年讲座 + 官网）。
          </p>
          <p class="video-update-meta" id="courses-update-meta"></p>
        </div>
      </div>
      <div class="video-toolbar" id="courses-toolbar"></div>
      <div id="courses-list" class="courses-list">
        <p class="loading-hint">加载课程资源…</p>
      </div>
    </div>
  </section>

  <section id="section-news" class="section">
    <div class="section-panel">
      <Breadcrumb crumbs={[homeCrumb, { label: '新闻热点' }]} />
      <div class="tool-header">
        <div class="tool-icon" style="background:rgba(37,99,235,0.12);color:var(--accent)">📰</div>
        <div>
          <h2>一周内 AI 热点</h2>
          <p class="desc">近 7 天热点，按分类浏览。</p>
          <p class="video-update-meta" id="news-update-meta"></p>
        </div>
      </div>
      <div id="daily-news-list" class="news-list">
        <noscript><p class="loading-hint error-hint">请启用 JavaScript 以加载新闻。</p></noscript>
        <p class="loading-hint">加载 AI 新闻…</p>
      </div>
      <div id="news-watch-sources" class="news-watch-sources"></div>
      <div class="section-cta">
        <a href={asset('news/daily-ai-news.html')} class="cta-btn cta-btn-outline"
          >查看新闻归档页 →</a
        >
      </div>
    </div>
  </section>

  <section id="section-videos" class="section videos-section">
    <div class="section-panel">
      <Breadcrumb crumbs={[homeCrumb, { label: 'AI 视频' }]} />
      <div class="tool-header">
        <div class="tool-icon" style="background:rgba(37,99,235,0.12);color:var(--accent)">▶</div>
        <div>
          <h2>近期热门AI视频推荐</h2>
          <p class="desc">
            YouTube 与 B站分别：24 小时 Top3、30 天 Top3、100 天 Top4，每平台最多 10
            条，按播放量排序，日更。
          </p>
          <p class="video-update-meta" id="video-update-meta"></p>
        </div>
      </div>
      <div class="video-toolbar" id="video-toolbar">
        <div class="video-toolbar-group" role="group" aria-label="视频平台">
          <span class="video-toolbar-label" id="video-platform-label">平台</span>
          <button
            type="button"
            class="video-filter active"
            data-video-platform="all"
            aria-pressed="true">全部</button
          >
          <button
            type="button"
            class="video-filter"
            data-video-platform="youtube"
            aria-pressed="false">YouTube</button
          >
          <button
            type="button"
            class="video-filter"
            data-video-platform="bilibili"
            aria-pressed="false">B站</button
          >
        </div>
        <div class="video-toolbar-group" role="group" aria-label="视频排序">
          <span class="video-toolbar-label" id="video-sort-label">排序</span>
          <button
            type="button"
            class="video-sort active"
            data-video-sort="views"
            aria-pressed="true">热门</button
          >
          <button type="button" class="video-sort" data-video-sort="recent" aria-pressed="false"
            >最新</button
          >
        </div>
      </div>
      <div id="daily-video-list" class="daily-video-list">
        <noscript><p class="loading-hint error-hint">请启用 JavaScript 以加载视频。</p></noscript>
        <p class="loading-hint">加载视频推荐…</p>
      </div>
    </div>
  </section>
</HomeLayout>
