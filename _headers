# Cloudflare Pages / Cloudflare 代理站点使用的安全响应头
# 同步进 dist/ 后，由 Cloudflare 在边缘注入（GitHub Pages 本身不读此文件）

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; form-action 'self'; script-src-attr 'none'; img-src 'self' data: blob: https:; media-src 'self' https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms https://cloud.umami.is https://*.umami.is https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.clarity.ms https://*.clarity.ms https://cloud.umami.is https://*.umami.is https://cloudflareinsights.com https://*.cloudflareinsights.com https://api.github.com https://noembed.com https://api.microlink.io https://*.workers.dev https://upload.uploadcare.com https://ucarecdn.com https://*.ucarecdn.com https://bioai-video-sync.fanyucai3.workers.dev https://*.fanyucai3.workers.dev; upgrade-insecure-requests

/style.css
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/lib/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/vendor/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/video-thumbs/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/og-image.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/ai-courses.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/ai-news.json
  Cache-Control: public, max-age=1800, stale-while-revalidate=300

/daily-videos.latest.json
  Cache-Control: public, max-age=1800, stale-while-revalidate=300

/local-deploy.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/search-index.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=600

/engagement.json
  Cache-Control: public, max-age=1800, stale-while-revalidate=300

/recommend-rules.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/analytics-config.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
